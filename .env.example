# =============================================================================
# ArchiVision AI — Environment Variables Template
# =============================================================================
# This file is a TEMPLATE. Do not put secrets here.
# Copy values into the files listed below. Never commit those copies.
# =============================================================================
#
# WHERE TO PUT LOCAL ENV FILES
# ----------------------------
# Next.js and FastAPI do NOT share a single .env automatically.
#
#   Frontend (Next.js)
#     Copy NEXT_PUBLIC_* vars to:  frontend/.env.local
#     Next.js only reads env files from the frontend directory.
#     NEXT_PUBLIC_* values are inlined at build time.
#
#   Backend (FastAPI)
#     Copy ENVIRONMENT / API_* vars to:  backend/.env
#     Settings load env_file=".env" relative to the process working directory.
#     Start uvicorn from backend/ so backend/.env is found.
#     A file named .env at the repository root is NOT loaded by the API.
#
#   gitignore already excludes .env, .env.local, and backend/.env
#
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Frontend (Next.js) — prefix public vars with NEXT_PUBLIC_
# Put these in frontend/.env.local
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=ArchiVision AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the FastAPI service. No trailing slash.
# Local:  http://localhost:8000
# Prod:   https://<your-render-service>.onrender.com  (set this in Vercel)
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# Put these in backend/.env when running uvicorn from backend/
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated browser origins allowed to call the API (CORS).
# Each origin is scheme + host + optional port. No path. No trailing slash.
# Local:  http://localhost:3000
# Prod:   https://<your-app>.vercel.app,http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Production (set in Vercel / Render dashboards — do not commit values)
# -----------------------------------------------------------------------------
# Vercel:
#   NEXT_PUBLIC_API_URL=https://<your-render-service>.onrender.com
# Render:
#   ENVIRONMENT=production
#   API_CORS_ORIGINS=https://<your-app>.vercel.app,http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (Milestone M2+ — leave commented until configured)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=

# -----------------------------------------------------------------------------
# AI Worker (Milestone M5+ — leave commented until configured)
# -----------------------------------------------------------------------------
# AI_WORKER_URL=
# HF_HOME=./models/hf_cache

# -----------------------------------------------------------------------------
# ChromaDB (Milestone M11+ — leave commented until configured)
# -----------------------------------------------------------------------------
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
